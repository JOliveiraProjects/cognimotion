{
    "FileVersion": 3,
    "Version": 2,
    "VersionName": "1.1.0",
    "FriendlyName": "Cognitive NPC - Perception, Behavior & Neural Animation",
    "Description": "A complete NPC intelligence toolkit for UE5. Tag any actor as enemy/friend/weapon/vehicle/traffic-light; NPCs perceive the world, decide reactions (attack, flee, hide, pick up, enter, cross), handle physical states (alive, dead, falling, swimming), and hold objects on their skeleton. Includes an optional neural-animation module (DreamerV3 world model) that learns movement by observing a character. Designer-friendly, no ML required for the core systems.",
    "Category": "AI",
    "CreatedBy": "Cognitive Systems",
    "CreatedByURL": "",
    "DocsURL": "",
    "MarketplaceURL": "",
    "SupportURL": "",
    "CanContainContent": true,
    "IsBetaVersion": false,
    "IsExperimentalVersion": false,
    "Installed": false,
    "EnabledByDefault": false,
    "Plugins": [
        { "Name": "EnhancedInput", "Enabled": true },
        { "Name": "MotionTrajectory", "Enabled": true, "Optional": true },
        { "Name": "GameplayAbilities", "Enabled": true, "Optional": false }
    ],
    "Modules": [
        {
            "Name": "CognitiveMotionIntelligence",
            "Type": "Runtime",
            "LoadingPhase": "Default",
            "AdditionalDependencies": [ "Engine", "CoreUObject" ]
        },
        {
            "Name": "CognitiveMotionIntelligenceEditor",
            "Type": "UncookedOnly",
            "LoadingPhase": "PostEngineInit",
            "AdditionalDependencies": [ "Engine", "CoreUObject", "UnrealEd" ]
        }
    ]
}
